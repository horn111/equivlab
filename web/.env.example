# GenLayer deployment. The interface renders an explicit unavailable state while
# these are unset; no transaction or authoritative readback is simulated.
VITE_NETWORK_NAME=
VITE_REGISTRY_ADDRESS=
VITE_GENLAYER_RPC_URL=
VITE_EXPLORER_BASE_URL=

# Exact public GitHub revision used by the bundled reference-fixture cards.
# Production must use a full 40-character commit hash, never a branch name.
VITE_DEMO_REPOSITORY=
VITE_DEMO_COMMIT=
